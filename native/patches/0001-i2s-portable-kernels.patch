diff --git a/include/gemm-config.h b/include/gemm-config.h
index 6a88c42..0e44643 100644
--- a/include/gemm-config.h
+++ b/include/gemm-config.h
@@ -14,7 +14,12 @@
 #if defined(ACT_PARALLEL)
     #define ROW_BLOCK_SIZE 8
     #define COL_BLOCK_SIZE 256
-    #define PARALLEL_SIZE 8
+    // PARALLEL_SIZE must divide every gemm row-block count. The gemm path
+    // (ggml-aarch64.c) processes ROW_BLOCK_SIZE(=8) rows per outer step but
+    // the final tail block can be 4 (ne11 rounded down to a multiple of 4),
+    // so PARALLEL_SIZE=8 would mis-route that tail to the _1x1 kernel, whose
+    // argument semantics differ from _Nx1 -> garbage. 4 divides both 8 and 4.
+    #define PARALLEL_SIZE 4
 #else
     #define ROW_BLOCK_SIZE 64
     #define COL_BLOCK_SIZE 16
@@ -31,5 +36,18 @@
     #define PARALLEL_SIZE 4
 #endif // ACT_PARALLEL
 #endif // __ARM_FEATURE_DOTPROD
+#else
+// No SIMD ISA detected (e.g. a generic host build with GGML_NATIVE=OFF, or an
+// Android x86_64 target compiled without -mavx2). The portable scalar i2_s
+// kernels in ggml-bitnet-mad.cpp use these too, so they must always be defined.
+#if defined(ACT_PARALLEL)
+    #define ROW_BLOCK_SIZE 4
+    #define COL_BLOCK_SIZE 128
+    #define PARALLEL_SIZE 4
+#else
+    #define ROW_BLOCK_SIZE 128
+    #define COL_BLOCK_SIZE 32
+    #define PARALLEL_SIZE 4
+#endif // ACT_PARALLEL
 #endif // __AVX__
 
